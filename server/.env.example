# Copy to server/.env and fill in. Never commit server/.env.

# HTTP server. Without admin login the server only starts on localhost.
PORT=4000
HOST=127.0.0.1
# Production: NODE_ENV=production requires admin login, sets Secure cookies and HSTS.
NODE_ENV=development
# Behind a hosting proxy (Render, Railway), set to 1 so rate limits use the forwarded client address.
TRUST_PROXY=false
# Only when the dashboard is hosted on another domain (e.g. Vercel): its exact origin(s), comma-separated,
# with https:// and no trailing path, e.g. https://your-project.vercel.app. Leave empty when Render serves the dashboard.
# Local Vite (http://localhost:5173) is always allowed outside production.
CORS_ORIGINS=
# Optional: comma-separated DNS servers if your network cannot resolve Atlas mongodb+srv:// records.
DNS_SERVERS=

# Admin login for the dashboard and API — generate with: npm run setup-admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_HOURS=8
# Signed-in admins are signed out after this many minutes without activity.
SESSION_IDLE_MINUTES=60

# MongoDB (local mongod or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/offerly

# Claude API — get a key at https://console.anthropic.com (separate from Claude Code)
# AI_MODE: auto = live when a key is set, otherwise deterministic fallback only; off = never call Claude
AI_MODE=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=20000

# Telegram — create a bot with @BotFather and paste the token
# TELEGRAM_MODE: auto = long polling when a token is set; off = bot disabled
TELEGRAM_MODE=auto
TELEGRAM_BOT_TOKEN=
